# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Telegram Bot Configuration
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# App URL for Telegram WebApp (when running in production or tunnel)
# For local browser testing, this is not required
WEBAPP_URL=http://localhost:8080

# Demo Mode
# When true, pre-seeds a realistic group (Summer Trip to Rome) with sample expenses and members
DEMO_MODE=true

# Database Path
DATABASE_PATH=./data/tabmate.db
